# Local maintainer tooling only. Never commit real secrets.
CURSEFORGE_API_KEY=
CURSEFORGE_API_URL=https://api.curseforge.com

# Optional; leave unset to use the public main-branch overrides.
# Release workflow sets an immutable URL pinned to the checked-out source commit.
# MARS_OVERRIDE_BASE_URL=https://raw.githubusercontent.com/OWNER/REPO/COMMIT/modpack/Mars%20Client/overrides

# Batch 3 community/account public deployment configuration.
# Native builds read approved public settings from .env.dev (debug) / .env.prod (release).
# Process environment overrides the local file; versioned config/production.env supplies CI defaults.
# Do not package dotenv files or put JWT/provider/private signing secrets into the client.
# API server origin/base WITHOUT /api, including Batch 3 /api/community/capsules.
# Desktop streams JARs with its Rust-held session bearer; no upload keys are needed here.
# Client ceiling: 64 MiB. Backend operator limits are authoritative (defaults 64 MiB/10 active/7 days).
# Private bucket paths, worker/scanner credentials, and backup settings belong only on the server.
# Disabled scanning yields private/unpublished scan_blocked, never a production clean result.
MARS_COMMUNITY_API_BASE=https://api.nexusgit.info
# Website origin/base: desktop verification must match <base>/auth/login?requestId=...
MARS_WEBSITE_BASE=https://mars.nexusgit.info
# Explicit recipient required; no default and no client-side role grants.
MARS_SPONSORS_URL=

# Pack endpoint and Ed25519 public verification key.
MARS_MANIFEST_BASE_URL=https://api.nexusgit.info/api/v1
MARS_MANIFEST_PUBLIC_KEY=a88e7dc70a1227cbc3decac967664e3bea75da9d72550e14f2c6a4ea8118391e
# Legacy MARS_COMMAND_API_URL=<origin> is accepted and resolves to <origin>/api/v1.

# Public updater key only. Native builds embed this allowlisted setting.
# Use the literal outer-base64 contents of the Tauri .pub file, not a path.
# Leave this line commented to retain the versioned production public key.
# An explicit empty override disables debug updates; release builds reject it.
# MARS_UPDATER_PUBLIC_KEY=
# Never put TAURI_SIGNING_PRIVATE_KEY or its password in this file.
# Keep the updater private key outside the repository and in protected CI secrets.
