{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "mars-command-client",
	"version": "1.4.2",
	"identifier": "com.jorda.mars-command-client",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Mars Command",
				"width": 1180,
				"height": 760,
				"minWidth": 920,
				"minHeight": 620,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": true,
				"shadow": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGOUJBOTQ4OUI5RDhBNEUKUldST2lwMmJTS21iRC83LzZoSlhhNk9POWYxZC90UnBFL1hTQkphcHZtMGl4RVNiU0wxTXhiM2UK",
			"endpoints": [
				"https://github.com/Mars-Command/Client-Launcher/releases/latest/download/latest.json"
			],
			"requireSignedVersion": true,
			"allowDowngrades": false,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
